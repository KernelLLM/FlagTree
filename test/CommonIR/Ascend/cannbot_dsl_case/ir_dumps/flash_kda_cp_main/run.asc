struct ProfilingTensorV1 {
    uint32_t role, dataType, format, rank;
    const int64_t* shape;
};
struct ProfilingCallbacksV1 {
    uint32_t version, size;
    void* context;
    int32_t (*begin)(void*, const char*, const char*, uint64_t, uint32_t, uint32_t,
                     void*, const ProfilingTensorV1*, uint64_t) noexcept;
    int32_t (*end)(void*) noexcept;
};
static_assert(sizeof(ProfilingTensorV1) == 24, "profiling tensor ABI");
static_assert(sizeof(ProfilingCallbacksV1) == 32, "profiling callback ABI");

struct CannBotCallFrameHeaderV9 {
    uint32_t magic;
    uint16_t host_abi_version;
    uint16_t schema_version;
    uint32_t slot_count;
    uint32_t reserved;
    uint64_t frame_bytes;
    uint8_t contract_digest[32];
};

struct CannBotHostSlotSchemaV2 {
    uint32_t kind;
    uint32_t flags;
    uint32_t dtype_code;
    uint32_t dtype_bits;
    uint32_t dtype_lanes;
    uint32_t encoding;
    uint32_t logical_rank;
    uint32_t physical_rank;
    uint64_t offset;
    uint64_t size;
    uint64_t alignment;
    uint64_t pointer_offset;
    uint64_t shape_offset;
    uint64_t stride_offset;
    uint64_t physical_shape_offset;
    uint64_t physical_stride_offset;
    uint8_t abi_type_digest[32];
};

struct CannBotHostSchemaV2 {
    uint32_t magic;
    uint16_t host_abi_version;
    uint16_t schema_version;
    uint32_t slot_count;
    uint32_t reserved;
    uint64_t frame_bytes;
    uint64_t frame_alignment;
    uint8_t contract_digest[32];
    const CannBotHostSlotSchemaV2* slots;
};

static_assert(sizeof(CannBotCallFrameHeaderV9) == 56,
              "CANNBotDSL ABI v9 frame header size mismatch");
static_assert(alignof(CannBotCallFrameHeaderV9) == 8,
              "CANNBotDSL ABI v9 frame header alignment mismatch");
static_assert(offsetof(CannBotCallFrameHeaderV9, contract_digest) == 24,
              "CANNBotDSL ABI v9 frame header layout mismatch");
static_assert(sizeof(CannBotHostSlotSchemaV2) == 128,
              "CANNBotDSL ABI v9 slot schema size mismatch");

__aicore__ inline uint16_t cannbotdsl_get_ffts_config(uint16_t flagId, uint16_t mode)
{
    constexpr uint16_t SYNC_MODE_SHIFT_VALUE = 4;
    constexpr uint16_t SYNC_FLAG_SHIFT_VALUE = 8;
    return 0x1 + ((mode & 0x3) << SYNC_MODE_SHIFT_VALUE) + ((flagId & 0xf) << SYNC_FLAG_SHIFT_VALUE);
}

