    uint32_t dtype_bits;
    uint32_t dtype_lanes;
    uint32_t encoding;
    uint32_t logical_rank;
    uint32_t physical_rank;
    uint64_t offset;
    uint64_t size;
    uint64_t alignment;
    uint64_t pointer_offset;
    uint64_t shape_offset;
    uint64_t stride_offset;
    uint64_t physical_shape_offset;
    uint64_t physical_stride_offset;
