// STATUS: NOT COMPILED. The #include in CommonIRToHIVM.cpp was removed once
// lowerViewLoad/lowerViewStore moved to emitGatherLoad/emitScatterStore in
// TensorViewLowering.cpp. Nothing here is reachable, and the live helpers with
// these same names are the ones in that .cpp -- do not edit this file expecting
// to change behaviour.
//
// It is retained for emitAffineGmTile and emitAffineRunInBounds, the only
// working implementation of the SingleAffineDMA path, which
// emitSingleAffineGather/Scatter still need (they are failure() stubs). Port
// what is needed out of here rather than reviving the include; the rest has
// diverged from the live code. See documents/commonir/tensorview_known_issues.md
// Issues 1 and 3.
//
// Written to be included from CommonIRToHIVM.cpp at file scope; not a
// standalone TU.
//
// Sparse-index bounds checking is asymmetric between the two directions,
// because clamping and skipping are not equally available on both:
//
//   * Gather (load) checks. Reading a row has no side effect, so an
//     out-of-range coordinate can be handled by simply not loading it: the
//     destination is pre-filled with the view's `padding_value` and the row is
//     left alone. The predicate is computed for the whole index tensor at once
//     (emitSparseInBoundsMask) so the row loop only extracts its own lane.
//
//   * Scatter (store) checks too, but keeps the predicate per row. A write
//     cannot be redirected the way a read can -- clamping would corrupt
//     whatever row it clamps onto -- so an out-of-range row is dropped by an
//     scf.if rather than absorbed by a pre-fill. `padding_value` does not apply
//     to a sparse store lane; there is nothing to pad.
//
// The *dense* payload is range-checked in both directions
// (emitDensePayloadInBounds), because that is a property of tile vs. base shape
// rather than of the index values.

static Value emitAnd(OpBuilder &b, Location loc, Value lhs, Value rhs) {
  return b.create<arith::AndIOp>(loc, lhs, rhs);
}

static Value emitNonNegative(OpBuilder &b, Location loc, Value value) {
  Value zero = b.create<arith::ConstantIndexOp>(loc, 0);
  return b.create<arith::CmpIOp>(loc, arith::CmpIPredicate::sge, value, zero);
}

/// Whether the dense part of the tile -- view dims 1..rank, i.e. everything
/// below the sparse dimension -- lies inside the base shape. A coordinate on
/// those dims is a block index whose tile covers tile[d] contiguous elements,
/// so the test is on the whole span (origin + tile[d] <= extent) and the answer
/// is one i1 for the entire tile: a multi-dim tile's in-bounds region is
/// generally L-shaped and cannot be salvaged per row, which is why the caller
/// falls back to the element-wise path instead. The sparse dimension is checked
/// separately and per row by emitSparseInBoundsMask.
static Value emitDensePayloadInBounds(OpBuilder &b, Location loc,
                                      const TensorViewAccessInfo &info,
                                      ValueRange indices) {
  Value allIn = b.create<arith::ConstantIntOp>(loc, 1, 1);

  for (unsigned viewDim = 1; viewDim < info.tile.size(); ++viewDim) {
    unsigned baseDim = static_cast<unsigned>(info.dimMap[viewDim]);
    Value index = asIndexValue(b, loc, indices[viewDim]);
    Value traversal =
        b.create<arith::ConstantIndexOp>(loc, info.traversal[viewDim]);
    Value origin = b.create<arith::MulIOp>(loc, index, traversal);
    Value tileSize = b.create<arith::ConstantIndexOp>(loc, info.tile[viewDim]);
    Value end = b.create<arith::AddIOp>(loc, origin, tileSize);
    Value extent = asIndexValue(b, loc, info.shape[baseDim]);

    Value nonNeg = emitNonNegative(b, loc, origin);
    Value within =
        b.create<arith::CmpIOp>(loc, arith::CmpIPredicate::sle, end, extent);
    allIn = emitAnd(b, loc, allIn, emitAnd(b, loc, nonNeg, within));
  }

  return allIn;
}

/// Legal range of indices[0] on the view's sparse dimension.
static Value emitSparseExtent(OpBuilder &b, Location loc,
                              const TensorViewAccessInfo &info) {
  unsigned baseDim = static_cast<unsigned>(info.dimMap[0]);
  return asIndexValue(b, loc, info.shape[baseDim]);
}

/// Whether each sparse coordinate addresses a mapped row, as one i1 lane per
/// row: 0 <= indices[0][row] < extent.
///
/// This is the sparse-dimension counterpart to emitDensePayloadInBounds and the
/// two do not overlap: that one tests view dims 1..rank, where a coordinate is
/// a block index covering tile[d] contiguous elements and the whole tile stands
/// or falls together, so it yields a single i1. Here the coordinate is one
/// independent point per row, so the answer is one i1 lane per row and only the
/// offending rows drop out.
///
/// Computed once on the whole index tensor so the per-row loop only has to
/// extract its own lane, instead of re-deriving the comparison with four scalar
/// ops per iteration.
static Value emitSparseInBoundsMask(OpBuilder &b, Location loc,
                                    const TensorViewAccessInfo &info,
                                    ValueRange indices) {
  auto idxTy = cast<RankedTensorType>(indices[0].getType());
  Type idxElem = idxTy.getElementType();

  Value extent = emitSparseExtent(b, loc, info);
  Value extentElem = b.create<arith::IndexCastOp>(loc, idxElem, extent);

  Value zero = b.create<arith::ConstantOp>(loc, b.getZeroAttr(idxElem));
  Value zeroSplat = b.create<tensor::SplatOp>(loc, idxTy, zero);
  Value extentSplat = b.create<tensor::SplatOp>(loc, idxTy, extentElem);

  Value nonNeg = b.create<arith::CmpIOp>(loc, arith::CmpIPredicate::sge,
                                         indices[0], zeroSplat);
  Value below = b.create<arith::CmpIOp>(loc, arith::CmpIPredicate::slt,
                                        indices[0], extentSplat);
  return b.create<arith::AndIOp>(loc, nonNeg, below);
}

static Value emitPayloadBaseOffset(OpBuilder &b, Location loc,
                                   const TensorViewAccessInfo &info, ValueRange indices,
                                   Value sparseLogical) {
  Value offset;

  for (unsigned viewDim = 0; viewDim < info.tile.size(); ++viewDim) {
    unsigned baseDim = static_cast<unsigned>(info.dimMap[viewDim]);

    Value logical;
    if (viewDim == 0) {
      logical = asIndexValue(b, loc, sparseLogical);
    } else {
      Value index = asIndexValue(b, loc, indices[viewDim]);
      Value traversal =
          b.create<arith::ConstantIndexOp>(loc, info.traversal[viewDim]);
      logical = b.create<arith::MulIOp>(loc, index, traversal);
    }

    Value stride = asIndexValue(b, loc, info.strides[baseDim]);
    Value physical = b.create<arith::MulIOp>(loc, logical, stride);
    offset = offset ? b.create<arith::AddIOp>(loc, offset, physical) : physical;
  }

  return offset;
}

static Value emitPayloadGmView(OpBuilder &b, Location loc,
                               const TensorViewAccessInfo &info, Value offset) {
  SmallVector<int64_t> shape(info.tile.begin(), info.tile.end());
  shape[0] = 1;

  SmallVector<OpFoldResult> sizes;
  SmallVector<OpFoldResult> strides;
  SmallVector<int64_t> strideStatic;

  for (unsigned viewDim = 0; viewDim < info.tile.size(); ++viewDim) {
    unsigned baseDim = static_cast<unsigned>(info.dimMap[viewDim]);
    sizes.push_back(b.getIndexAttr(shape[viewDim]));

    int64_t stride = info.staticStrides[baseDim];
    strideStatic.push_back(stride);
    if (stride == ShapedType::kDynamic)
      strides.push_back(info.strides[baseDim]);
    else
      strides.push_back(b.getIndexAttr(stride));
  }

  auto layout = StridedLayoutAttr::get(b.getContext(), ShapedType::kDynamic,
                                       strideStatic);
  auto space =
      hivm::AddressSpaceAttr::get(b.getContext(), hivm::AddressSpace::GM);
  auto gmTy = MemRefType::get(shape, info.elementType, layout, space);

  return b.create<memref::ReinterpretCastOp>(
      loc, gmTy, info.base, OpFoldResult(offset), sizes, strides);
}

static Value emitPayloadBufferSubview(OpBuilder &b, Location loc, Value buffer,
                                      const TensorViewAccessInfo &info, Value row) {
  SmallVector<OpFoldResult> offsets;
  SmallVector<OpFoldResult> sizes;
  SmallVector<OpFoldResult> strides;

  for (unsigned d = 0; d < info.tile.size(); ++d) {
    offsets.push_back(d == 0 ? OpFoldResult(row)
                             : OpFoldResult(b.getIndexAttr(0)));
    sizes.push_back(b.getIndexAttr(d == 0 ? 1 : info.tile[d]));
    strides.push_back(b.getIndexAttr(1));
  }

  return b.create<memref::SubViewOp>(loc, buffer, offsets, sizes, strides);
}

/// Gather one payload block per sparse index:
///
///   dst[row, payload...] = src[index[row], payload...]
///
/// Two things are hoisted out of the row loop: the whole-tile pad fill, so an
/// out-of-range row just stays unwritten, and the bounds comparison, so the
/// body only extracts its own predicate lane. What is left per row is one
/// extract plus the guarded DMA; an out-of-range row does not even compute an
/// address.
static Value emitPerIndexPayloadGather(OpBuilder &b, Location loc,
                                       const TensorViewAccessInfo &info,
                                       ValueRange indices,
                                       RankedTensorType resultTy,
                                       hivm::AddressSpace space, Value pad) {
  Value buffer = b.create<memref::AllocOp>(
      loc, makeSpaceMemref(b.getContext(), info.tile, info.elementType, space));

  // Pre-fill the whole tile; in-range rows overwrite their own slice below.
  b.create<hivm::VBrcOp>(loc, TypeRange{}, pad, buffer);

  Value inBoundsMask = emitSparseInBoundsMask(b, loc, info, indices);

  Value zero = b.create<arith::ConstantIndexOp>(loc, 0);
  Value one = b.create<arith::ConstantIndexOp>(loc, 1);
  Value rows = b.create<arith::ConstantIndexOp>(loc, info.tile[0]);

  auto loop = b.create<scf::ForOp>(loc, zero, rows, one);
  {
    OpBuilder::InsertionGuard guard(b);
    b.setInsertionPointToStart(loop.getBody());

    Value row = loop.getInductionVar();
    Value inBounds =
        b.create<tensor::ExtractOp>(loc, inBoundsMask, ValueRange{row});

    b.create<scf::IfOp>(
        loc, inBounds, [&](OpBuilder &nested, Location nestedLoc) {
          Value rawIndex = nested.create<tensor::ExtractOp>(
              nestedLoc, indices[0], ValueRange{row});
          Value sparseLogical = asIndexValue(nested, nestedLoc, rawIndex);

          Value offset = emitPayloadBaseOffset(nested, nestedLoc, info, indices,
                                               sparseLogical);
          Value gm = emitPayloadGmView(nested, nestedLoc, info, offset);
          Value bufferSubview =
              emitPayloadBufferSubview(nested, nestedLoc, buffer, info, row);

          nested.create<hivm::LoadOp>(nestedLoc, TypeRange{}, gm,
                                      bufferSubview);
          nested.create<scf::YieldOp>(nestedLoc);
        });
  }

  return b.create<bufferization::ToTensorOp>(loc, resultTy, buffer, true,
                                             false);
}

/// Materialize the complete tensor source into a single UB tile once. Per-row
/// payload stores then take subviews of this buffer instead of repeatedly
/// extracting/materializing tensor slices.
static Value materializeScatterSourceToUb(OpBuilder &b, Location loc,
                                          const TensorViewAccessInfo &info,
                                          Value source,
                                          hivm::AddressSpace space) {
  Value buffer = b.create<memref::AllocOp>(
      loc, makeSpaceMemref(b.getContext(), info.tile, info.elementType, space));

  auto materialize =
      b.create<bufferization::MaterializeInDestinationOp>(loc, source, buffer);
  materialize->setAttr("writable", b.getUnitAttr());

  return buffer;
}

/// Scatter one payload block per sparse index, the mirror of
/// emitPerIndexPayloadGather:
///
///   dst[index[row], payload...] = src[row, payload...]
///
/// Each row is guarded and an out-of-range coordinate is dropped. The gather's
/// trick of pre-filling the destination has no analogue here -- a store cannot
/// be redirected or undone -- so the predicate stays per row; only its
/// computation is hoisted, as one vector compare over the whole index tensor.
static void emitPerIndexPayloadScatter(OpBuilder &b, Location loc,
                                       const TensorViewAccessInfo &info,
                                       ValueRange indices, Value source,
                                       hivm::AddressSpace srcSpace) {
  Value ub = materializeScatterSourceToUb(b, loc, info, source, srcSpace);

  Value inBoundsMask = emitSparseInBoundsMask(b, loc, info, indices);

  Value zero = b.create<arith::ConstantIndexOp>(loc, 0);
  Value one = b.create<arith::ConstantIndexOp>(loc, 1);
  Value rows = b.create<arith::ConstantIndexOp>(loc, info.tile[0]);

  auto loop = b.create<scf::ForOp>(loc, zero, rows, one);
  {
    OpBuilder::InsertionGuard guard(b);
    b.setInsertionPointToStart(loop.getBody());

    Value row = loop.getInductionVar();
    Value inBounds =
        b.create<tensor::ExtractOp>(loc, inBoundsMask, ValueRange{row});

    b.create<scf::IfOp>(
        loc, inBounds, [&](OpBuilder &nested, Location nestedLoc) {
          Value rawIndex = nested.create<tensor::ExtractOp>(
              nestedLoc, indices[0], ValueRange{row});
          Value sparseLogical = asIndexValue(nested, nestedLoc, rawIndex);

          Value offset = emitPayloadBaseOffset(nested, nestedLoc, info, indices,
                                               sparseLogical);
          Value gm = emitPayloadGmView(nested, nestedLoc, info, offset);
          Value ubRow =
              emitPayloadBufferSubview(nested, nestedLoc, ub, info, row);

          nested.create<hivm::StoreOp>(nestedLoc, TypeRange{}, ubRow, gm);
          nested.create<scf::YieldOp>(nestedLoc);
        });
  }
}

static Value emitAffineGmTile(OpBuilder &b, Location loc,
                              const TensorViewAccessInfo &info, Value offset,
                              int64_t indexStep) {
  SmallVector<OpFoldResult> sizes;
  SmallVector<OpFoldResult> strides;
  SmallVector<int64_t> strideStatic;

  for (unsigned viewDim = 0; viewDim < info.tile.size(); ++viewDim) {
    unsigned baseDim = static_cast<unsigned>(info.dimMap[viewDim]);
    sizes.push_back(b.getIndexAttr(info.tile[viewDim]));

    int64_t staticStride = info.staticStrides[baseDim];
    if (viewDim == 0) {
      if (staticStride == ShapedType::kDynamic) {
        strideStatic.push_back(ShapedType::kDynamic);
        Value step = b.create<arith::ConstantIndexOp>(loc, indexStep);
        Value baseStride = asIndexValue(b, loc, info.strides[baseDim]);
        strides.push_back(
            b.create<arith::MulIOp>(loc, baseStride, step).getResult());
      } else {
        int64_t combined = staticStride * indexStep;
        strideStatic.push_back(combined);
        strides.push_back(b.getIndexAttr(combined));
      }
      continue;
    }

    strideStatic.push_back(staticStride);
    if (staticStride == ShapedType::kDynamic)
      strides.push_back(info.strides[baseDim]);
    else
      strides.push_back(b.getIndexAttr(staticStride));
  }

  auto layout = StridedLayoutAttr::get(b.getContext(), ShapedType::kDynamic,
                                       strideStatic);
  auto gmSpace =
      hivm::AddressSpaceAttr::get(b.getContext(), hivm::AddressSpace::GM);
  auto gmTy = MemRefType::get(info.tile, info.elementType, layout, gmSpace);

  return b.create<memref::ReinterpretCastOp>(
      loc, gmTy, info.base, OpFoldResult(offset), sizes, strides);
}

/// An affine run covers [first, first + (tile[0]-1)*step]. A single whole-tile
/// DMA cannot pad individual rows, so both ends are tested once per tile and a
/// run that leaves the extent is demoted to the per-index path -- which guards
/// each row -- rather than to the element-wise fallback.
static Value emitAffineRunInBounds(OpBuilder &b, Location loc,
                                   const TensorViewAccessInfo &info, Value first,
                                   int64_t indexStep) {
  Value extent = emitSparseExtent(b, loc, info);
  Value span = b.create<arith::ConstantIndexOp>(
      loc, (static_cast<int64_t>(info.tile[0]) - 1) * indexStep);
  Value last = b.create<arith::AddIOp>(loc, first, span);

  Value lo = indexStep >= 0 ? first : last;
  Value hi = indexStep >= 0 ? last : first;

  Value nonNeg = emitNonNegative(b, loc, lo);
  Value below =
      b.create<arith::CmpIOp>(loc, arith::CmpIPredicate::slt, hi, extent);
  return emitAnd(b, loc, nonNeg, below);
}

static Value
emitSingleAffineGatherDMA(OpBuilder &b, Location loc, const TensorViewAccessInfo &info,
                          ValueRange indices, RankedTensorType resultTy,
                          hivm::AddressSpace dstSpace, int64_t indexStep) {
  Value firstPos = b.create<arith::ConstantIndexOp>(loc, 0);
  Value firstRaw =
      b.create<tensor::ExtractOp>(loc, indices[0], ValueRange{firstPos});
  Value first = asIndexValue(b, loc, firstRaw);

  Value offset = emitPayloadBaseOffset(b, loc, info, indices, first);
  Value gm = emitAffineGmTile(b, loc, info, offset, indexStep);

  Value ub = b.create<memref::AllocOp>(
      loc,
      makeSpaceMemref(b.getContext(), info.tile, info.elementType, dstSpace));

  b.create<hivm::LoadOp>(loc, TypeRange{}, gm, ub);

  return b.create<bufferization::ToTensorOp>(loc, resultTy, ub, true, false);
}

/// Collapse an affine sparse index pattern into one whole-tile HIVM store.
static void emitSingleAffineScatterDMA(OpBuilder &b, Location loc,
                                       const TensorViewAccessInfo &info,
                                       ValueRange indices, Value source,
                                       hivm::AddressSpace srcSpace,
                                       int64_t indexStep) {
  Value ub = materializeScatterSourceToUb(b, loc, info, source, srcSpace);

  Value firstPos = b.create<arith::ConstantIndexOp>(loc, 0);
  Value firstRaw =
      b.create<tensor::ExtractOp>(loc, indices[0], ValueRange{firstPos});
  Value first = asIndexValue(b, loc, firstRaw);

  Value offset = emitPayloadBaseOffset(b, loc, info, indices, first);
  Value gm = emitAffineGmTile(b, loc, info, offset, indexStep);

  b.create<hivm::StoreOp>(loc, TypeRange{}, ub, gm);
}

static FailureOr<Value>
emitGatherScatterLoad(OpBuilder &b, Location loc, const TensorViewAccessInfo &info,
                      ValueRange indices, RankedTensorType resultTy,
                      hivm::AddressSpace dstSpace, Value pad) {
  auto access = mlir::triton::analyzeGatherScatterAccess(
      static_cast<const mlir::triton::TensorViewAccessInfo &>(info), indices);
  if (failed(access))
    return failure();

  auto plan = mlir::triton::chooseTensorViewPlan(
      static_cast<const mlir::triton::TensorViewAccessInfo &>(info), *access);
  if (failed(plan) || plan->isScalarTransfer())
    return failure();

  Value denseInBounds = emitDensePayloadInBounds(b, loc, info, indices);

  // Result types are inferred from the then-region's scf.yield; this MLIR
  // revision has no (TypeRange, cond, thenBuilder, elseBuilder) overload.
  auto guarded = b.create<scf::IfOp>(
      loc, denseInBounds,
      [&](OpBuilder &nested, Location nestedLoc) {
        // An affine index run collapses to one strided DMA, but only while the
        // run stays inside the extent: a whole-tile transfer has no way to pad
        // an individual row, so an escaping run falls back to the per-index
        // path instead.
        if (plan->isSingleAffineDMA()) {
          Value firstPos = nested.create<arith::ConstantIndexOp>(nestedLoc, 0);
          Value firstRaw = nested.create<tensor::ExtractOp>(
              nestedLoc, indices[0], ValueRange{firstPos});
          Value first = asIndexValue(nested, nestedLoc, firstRaw);
          Value runOk = emitAffineRunInBounds(nested, nestedLoc, info, first,
                                              plan->indexStep);

          auto runIf = nested.create<scf::IfOp>(
              nestedLoc, runOk,
              [&](OpBuilder &in, Location l) {
                Value r = emitSingleAffineGatherDMA(
                    in, l, info, indices, resultTy, dstSpace, plan->indexStep);
                in.create<scf::YieldOp>(l, r);
              },
              [&](OpBuilder &in, Location l) {
                Value r = emitPerIndexPayloadGather(in, l, info, indices,
                                                    resultTy, dstSpace, pad);
                in.create<scf::YieldOp>(l, r);
              });
          nested.create<scf::YieldOp>(nestedLoc, runIf.getResult(0));
          return;
        }

        Value result = emitPerIndexPayloadGather(
            nested, nestedLoc, info, indices, resultTy, dstSpace, pad);
        nested.create<scf::YieldOp>(nestedLoc, result);
      },
      [&](OpBuilder &nested, Location nestedLoc) {
        Value fallback = emitPaddedGatherLoad(nested, nestedLoc, info, indices,
                                              resultTy, dstSpace, pad);
        nested.create<scf::YieldOp>(nestedLoc, fallback);
      });

  return guarded.getResult(0);
}

/// Both the dense payload and the sparse coordinates are range-checked: an
/// out-of-bounds dense tile falls back to emitDiscreteScatter, and an
/// out-of-range sparse row is dropped by the per-index path.
///
/// Named for symmetry with emitGatherScatterLoad above, and distinctly from
/// mlir::triton::emitScatterStore in TensorViewLowering.h: both are visible at
/// this call site and ADL on TensorViewAccessInfo would otherwise make the call
/// ambiguous.
static LogicalResult emitGatherScatterStore(OpBuilder &b, Location loc,
                                            const TensorViewAccessInfo &info,
                                            ValueRange indices, Value source,
                                            hivm::AddressSpace srcSpace) {
  auto access = mlir::triton::analyzeGatherScatterAccess(
      static_cast<const mlir::triton::TensorViewAccessInfo &>(info), indices);
  if (failed(access))
    return failure();

  auto plan = mlir::triton::chooseTensorViewPlan(
      static_cast<const mlir::triton::TensorViewAccessInfo &>(info), *access);
  if (failed(plan) || plan->isScalarTransfer())
    return failure();

  // First-version optimization is valid only when the complete dense payload
  // fits. The else branch keeps the existing element-wise semantics.
  Value denseInBounds = emitDensePayloadInBounds(b, loc, info, indices);

  b.create<scf::IfOp>(
      loc, denseInBounds,
      [&](OpBuilder &nested, Location nestedLoc) {
        // Mirrors the gather side: the run collapses to one strided DMA only
        // while it stays inside the extent, since a whole-tile transfer cannot
        // drop an individual row. An escaping run falls back to the per-index
        // path, which guards each row.
        if (plan->isSingleAffineDMA()) {
          Value firstPos = nested.create<arith::ConstantIndexOp>(nestedLoc, 0);
          Value firstRaw = nested.create<tensor::ExtractOp>(
              nestedLoc, indices[0], ValueRange{firstPos});
          Value first = asIndexValue(nested, nestedLoc, firstRaw);
          Value runOk = emitAffineRunInBounds(nested, nestedLoc, info, first,
                                              plan->indexStep);

          nested.create<scf::IfOp>(
              nestedLoc, runOk,
              [&](OpBuilder &in, Location l) {
                emitSingleAffineScatterDMA(in, l, info, indices, source,
                                           srcSpace, plan->indexStep);
                in.create<scf::YieldOp>(l);
              },
              [&](OpBuilder &in, Location l) {
                emitPerIndexPayloadScatter(in, l, info, indices, source,
                                           srcSpace);
                in.create<scf::YieldOp>(l);
              });
          nested.create<scf::YieldOp>(nestedLoc);
        } else if (plan->isPerIndexPayloadDMA()) {
          emitPerIndexPayloadScatter(nested, nestedLoc, info, indices, source,
                                     srcSpace);
          nested.create<scf::YieldOp>(nestedLoc);
        }
      },
      [&](OpBuilder &nested, Location nestedLoc) {
        emitDiscreteScatter(nested, nestedLoc, info, indices, source);
        nested.create<scf::YieldOp>(nestedLoc);
      });

  return success();
}